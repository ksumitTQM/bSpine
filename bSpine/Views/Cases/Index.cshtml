@model CaseListViewModel
@{
    ViewData["Title"] = "Cases";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Cases</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New case</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-5 col-lg-4">
        <input asp-for="Search" class="form-control" placeholder="Search case #, client, attorney, paralegal" />
    </div>
    <div class="col-md-4 col-lg-3">
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<CaseStatus>()" class="form-select">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="card bs-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Case number</th>
                    <th>Client</th>
                    <th>Attorney / Paralegal</th>
                    <th>Status</th>
                    <th>Statute of limitations</th>
                    <th class="text-end">Medical specials</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Cases)
            {
                <tr class="@(item.IsSolExpired ? "table-danger" : item.IsSolWarning ? "table-warning" : "")">
                    <td><a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold">@item.CaseNumber</a></td>
                    <td>@item.Client?.FullName</td>
                    <td>@item.AssignedAttorney<div class="small text-muted">@item.Paralegal</div></td>
                    <td><span class="badge @item.Status.BadgeClass()">@item.Status</span></td>
                    <td><partial name="_SolBadge" model="item" /></td>
                    <td class="text-end">@item.TotalBilled.ToString("C")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Open</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Cases.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No cases match your filter.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
