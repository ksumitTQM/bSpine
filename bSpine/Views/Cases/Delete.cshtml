@model CaseDetailViewModel
@{
    ViewData["Title"] = "Delete case";
}

<h1 class="page-title">Delete case</h1>

<div class="card bs-card border-danger">
    <div class="card-body">
        <p class="lead">Are you sure you want to delete this case and all of its related records?</p>
        <dl class="row">
            <dt class="col-sm-3">Case number</dt>
            <dd class="col-sm-9">@Model.Case.CaseNumber</dd>
            <dt class="col-sm-3">Client</dt>
            <dd class="col-sm-9">@Model.Case.Client?.FullName</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge @Model.Case.Status.BadgeClass()">@Model.Case.Status</span></dd>
            <dt class="col-sm-3">Will also delete</dt>
            <dd class="col-sm-9">
                @Model.Treatments.Count treatments, @Model.Requests.Count records requests, @Model.Notes.Count notes
            </dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Case.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete case</button>
            <a asp-action="Details" asp-route-id="@Model.Case.Id" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
