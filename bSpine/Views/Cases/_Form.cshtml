@model LegalCase

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="CaseNumber" class="form-label"></label>
        <input asp-for="CaseNumber" class="form-control" placeholder="BS-2026-0200" />
        <span asp-validation-for="CaseNumber" class="text-danger"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="ClientId" class="form-label"></label>
        <select asp-for="ClientId" asp-items="(SelectList)ViewBag.Clients" class="form-select">
            <option value="">-- Select client --</option>
        </select>
        <span asp-validation-for="ClientId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<CaseStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="AssignedAttorney" class="form-label"></label>
        <input asp-for="AssignedAttorney" class="form-control" />
        <span asp-validation-for="AssignedAttorney" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Paralegal" class="form-label"></label>
        <input asp-for="Paralegal" class="form-control" />
        <span asp-validation-for="Paralegal" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="OpenedDate" class="form-label"></label>
        <input asp-for="OpenedDate" class="form-control" />
        <span asp-validation-for="OpenedDate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="StatuteOfLimitationsDate" class="form-label"></label>
        <input asp-for="StatuteOfLimitationsDate" class="form-control" />
        <span asp-validation-for="StatuteOfLimitationsDate" class="text-danger"></span>
        <div class="form-text">A warning is shown when the deadline is within @LegalCase.SolWarningDays days.</div>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>
