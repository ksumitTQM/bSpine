@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var maxCount = Math.Max(1, Model.StatusCounts.Values.DefaultIfEmpty(0).Max());
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Dashboard</h1>
    <a class="btn btn-primary" asp-controller="Cases" asp-action="Create"><i class="bi bi-plus-lg"></i> New case</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-tile">
            <div class="stat-label">Open cases</div>
            <div class="stat-value">@Model.OpenCases</div>
            <div class="stat-sub">of @Model.TotalCases total</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile @(Model.SolWarningCount > 0 ? "stat-warn" : "")">
            <div class="stat-label">SOL within @LegalCase.SolWarningDays days</div>
            <div class="stat-value">@Model.SolWarningCount</div>
            <div class="stat-sub">open cases needing attention</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile @(Model.OverdueRequests.Count > 0 ? "stat-danger" : "")">
            <div class="stat-label">Overdue records requests</div>
            <div class="stat-value">@Model.OverdueRequests.Count</div>
            <div class="stat-sub">follow-up required</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile">
            <div class="stat-label">Total medical specials</div>
            <div class="stat-value">@Model.TotalBilled.ToString("C0")</div>
            <div class="stat-sub">@Model.TotalPaid.ToString("C0") paid</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card bs-card h-100">
            <div class="card-header">Cases by status</div>
            <div class="card-body">
                @foreach (var entry in Model.StatusCounts)
                {
                    var width = entry.Value * 100 / maxCount;
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <a class="text-decoration-none" asp-controller="Cases" asp-action="Index" asp-route-status="@entry.Key">
                                <span class="badge @entry.Key.BadgeClass()">@entry.Key</span>
                            </a>
                            <strong>@entry.Value</strong>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-teal" role="progressbar" style="width: @(width)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card bs-card h-100">
            <div class="card-header">Upcoming statute of limitations deadlines</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Case</th><th>Client</th><th>Status</th><th>SOL date</th><th>Attorney</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.UpcomingSol)
                    {
                        <tr class="@(c.IsSolExpired ? "table-danger" : c.IsSolWarning ? "table-warning" : "")">
                            <td><a asp-controller="Cases" asp-action="Details" asp-route-id="@c.Id">@c.CaseNumber</a></td>
                            <td>@c.Client?.FullName</td>
                            <td><span class="badge @c.Status.BadgeClass()">@c.Status</span></td>
                            <td><partial name="_SolBadge" model="c" /></td>
                            <td>@c.AssignedAttorney</td>
                        </tr>
                    }
                    @if (!Model.UpcomingSol.Any())
                    {
                        <tr><td colspan="5" class="text-muted text-center py-3">No upcoming deadlines.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card bs-card h-100">
            <div class="card-header">Overdue records requests</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Case</th><th>Provider</th><th>Requested</th><th>Follow-up</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.OverdueRequests)
                    {
                        <tr>
                            <td>
                                @if (r.LegalCase != null)
                                {
                                    <a asp-controller="Cases" asp-action="Details" asp-route-id="@r.LegalCaseId">@r.LegalCase.CaseNumber</a>
                                    <div class="small text-muted">@r.LegalCase.Client?.FullName</div>
                                }
                            </td>
                            <td>@r.Provider?.Name</td>
                            <td>@r.RequestedDate.ToString("MMM d, yyyy")</td>
                            <td class="text-danger">@(r.FollowUpDate?.ToString("MMM d, yyyy") ?? "-")</td>
                        </tr>
                    }
                    @if (!Model.OverdueRequests.Any())
                    {
                        <tr><td colspan="4" class="text-muted text-center py-3">No overdue requests.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card bs-card h-100">
            <div class="card-header">Medical specials (billed) per case</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Case</th><th>Client</th><th class="text-end">Billed</th><th class="text-end">Paid</th><th class="text-end">Outstanding</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var s in Model.Specials)
                    {
                        <tr>
                            <td><a asp-controller="Cases" asp-action="Details" asp-route-id="@s.CaseId">@s.CaseNumber</a></td>
                            <td>@s.ClientName</td>
                            <td class="text-end fw-semibold">@s.Billed.ToString("C")</td>
                            <td class="text-end">@s.Paid.ToString("C")</td>
                            <td class="text-end">@s.Outstanding.ToString("C")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="2">Total</th>
                            <th class="text-end">@Model.TotalBilled.ToString("C")</th>
                            <th class="text-end">@Model.TotalPaid.ToString("C")</th>
                            <th class="text-end">@((Model.TotalBilled - Model.TotalPaid).ToString("C"))</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
