@model IEnumerable<Provider>
@{
    ViewData["Title"] = "Providers";
    var search = ViewData["Search"] as string;
    var selectedType = ViewData["Type"] as ProviderType?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Medical providers</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New provider</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-5 col-lg-4">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search name or city" />
    </div>
    <div class="col-md-4 col-lg-3">
        <select name="type" class="form-select">
            <option value="">All provider types</option>
            @foreach (var option in Enum.GetValues<ProviderType>())
            {
                <option value="@option" selected="@(selectedType == option)">@option.GetDisplayName()</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="card bs-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Name</th><th>Type</th><th>Specialty</th><th>Phone</th><th>City</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Name</td>
                    <td><span class="badge text-bg-light border">@item.Type.GetDisplayName()</span></td>
                    <td>@item.Specialty</td>
                    <td>@item.Phone</td>
                    <td>@item.City</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No providers found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
