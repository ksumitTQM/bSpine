@model Provider
@{
    ViewData["Title"] = "Delete provider";
}

<h1 class="page-title">Delete provider</h1>

<div class="card bs-card border-danger">
    <div class="card-body">
        <p class="lead">Are you sure you want to delete this provider?</p>
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.Type.GetDisplayName()</dd>
            <dt class="col-sm-3">City</dt>
            <dd class="col-sm-9">@(Model.City ?? "-")</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
