@model IEnumerable<Client>
@{
    ViewData["Title"] = "Clients";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Clients</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New client</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-6 col-lg-4">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search name or injury type" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="card bs-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>DOB / Age</th>
                    <th>Injury type</th>
                    <th>Injury date</th>
                    <th>Phone</th>
                    <th class="text-center">Cases</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold">@item.FullName</a></td>
                    <td>@item.DateOfBirth.ToString("MMM d, yyyy") <span class="text-muted">(@item.Age)</span></td>
                    <td>@item.InjuryType</td>
                    <td>@item.InjuryDate.ToString("MMM d, yyyy")</td>
                    <td>@item.Phone</td>
                    <td class="text-center">@item.Cases.Count</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No clients found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
