@model Client
@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">@Model.FullName</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card bs-card">
            <div class="card-header">Demographics</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Date of birth</dt>
                    <dd class="col-sm-8">@Model.DateOfBirth.ToString("MMM d, yyyy") (age @Model.Age)</dd>
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "-")</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "-")</dd>
                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card bs-card">
            <div class="card-header">Injury</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Injury type</dt>
                    <dd class="col-sm-8">@Model.InjuryType</dd>
                    <dt class="col-sm-4">Injury date</dt>
                    <dd class="col-sm-8">@Model.InjuryDate.ToString("MMM d, yyyy")</dd>
                    <dt class="col-sm-4">Summary</dt>
                    <dd class="col-sm-8">@(Model.InjurySummary ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card bs-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Cases</span>
                <a asp-controller="Cases" asp-action="Create" asp-route-clientId="@Model.Id" class="btn btn-sm btn-primary">New case</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Case number</th><th>Status</th><th>Attorney</th><th>SOL</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.Cases.OrderBy(x => x.StatuteOfLimitationsDate))
                    {
                        <tr>
                            <td><a asp-controller="Cases" asp-action="Details" asp-route-id="@c.Id">@c.CaseNumber</a></td>
                            <td><span class="badge @c.Status.BadgeClass()">@c.Status</span></td>
                            <td>@c.AssignedAttorney</td>
                            <td><partial name="_SolBadge" model="c" /></td>
                        </tr>
                    }
                    @if (!Model.Cases.Any())
                    {
                        <tr><td colspan="4" class="text-muted text-center py-3">No cases for this client.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
