@model Client
@{
    ViewData["Title"] = "Delete client";
}

<h1 class="page-title">Delete client</h1>

<div class="card bs-card border-danger">
    <div class="card-body">
        <p class="lead">Are you sure you want to delete this client?</p>
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>
            <dt class="col-sm-3">Injury type</dt>
            <dd class="col-sm-9">@Model.InjuryType</dd>
            <dt class="col-sm-3">Cases on file</dt>
            <dd class="col-sm-9">@Model.Cases.Count</dd>
        </dl>
        @if (Model.Cases.Any())
        {
            <div class="alert alert-warning">This client has cases on file; deletion will be refused until those cases are removed.</div>
        }
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
